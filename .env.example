# ============================================
# ОСНОВНЫЕ НАСТРОЙКИ БОТА
# ============================================

# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID администратора бота (ваш Telegram User ID)
# Получить можно у @userinfobot
ADMIN_ID=123456789

# ID чата где работает бот (для ограничения доступа)
ALLOWED_CHAT_ID=-1004266698610

# ============================================
# БАЗА ДАННЫХ
# ============================================

DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot

# ============================================
# TELEGRAM MTPROTO API (для автоматической выдачи подарков)
# ============================================

# Получить на https://my.telegram.org в разделе "API development tools"
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Путь к файлу сессии Telethon (создается при первом запуске auth_session.py)
TELETHON_SESSION=sessions/owner

# ============================================
# TELEGRAM STAR GIFT IDs
# ============================================
# Чтобы получить актуальные Gift IDs:
# 1. Запустите auth_session.py для авторизации
# 2. Запустите gift_worker с логированием DEBUG
# 3. Скопируйте ID подарков из списка getAvailableGifts
# 
# Или используйте эти ID как пример (могут устареть):


# ============================================
# НАСТРОЙКИ GIFT WORKER
# ============================================

# Максимальное количество попыток доставки подарка
MAX_DELIVERY_ATTEMPTS=3

# Интервал между проверками очереди (секунды)
WORKER_POLL_INTERVAL=5

# Таймаут для захвата задачи в обработку (минуты)
DELIVERY_CLAIM_TIMEOUT=5

# ============================================
# НАСТРОЙКИ ИГРЫ
# ============================================

GAME_ROWS=5
GAME_COLS=5

# ============================================
# ЛОГИРОВАНИЕ
# ============================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
